{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!**/*.md", "!**/test/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "ai": "Provider SDKs may only be imported in packages/core/src/router/gate.ts (ProviderGate).",
              "@ai-sdk/anthropic": "Provider SDKs may only be imported in packages/core/src/router/gate.ts (ProviderGate).",
              "@ai-sdk/google": "Provider SDKs may only be imported in packages/core/src/router/gate.ts (ProviderGate).",
              "@ai-sdk/openai-compatible": "Provider SDKs may only be imported in packages/core/src/router/gate.ts (ProviderGate)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/router/gate.ts", "packages/core/test/spikes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
