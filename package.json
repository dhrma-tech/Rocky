{
  "name": "rocky",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "rocky": "node apps/cli/src/index.ts",
    "test:security": "vitest run --project security --passWithNoTests",
    "test:spikes": "vitest run --project spikes",
    "build:web": "pnpm --filter @rocky/web build",
    "dev:web": "pnpm --filter @rocky/web dev",
    "dev": "pnpm --parallel --filter @rocky/daemon --filter @rocky/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
